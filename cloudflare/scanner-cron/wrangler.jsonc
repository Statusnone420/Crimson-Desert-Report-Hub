{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimson-report-hub-scanner-cron",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": { "bindings": [{ "name": "SCANNER_COORDINATOR", "class_name": "ScannerCoordinator" }] },
  "migrations": [{ "tag": "scanner-coordinator-v1", "new_sqlite_classes": ["ScannerCoordinator"] }],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "CRON_URL": "https://crimsonreporthub.com/api/cron/keepalive"
  }
}
