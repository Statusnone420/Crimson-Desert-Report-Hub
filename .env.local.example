# Copy this file to .env.local for local development.
# Never commit .env.local or real provider keys.

# Required: Supabase server-side database access.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required: admin login and signed session cookies.
ADMIN_PASSWORD=replace-with-long-private-passphrase
SESSION_SECRET=replace-with-64-hex-character-secret

# Required in production for cron/preview route authorization.
CRON_SECRET=replace-with-random-private-secret

# Strongly recommended: public report spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Real-scan software ceilings: 1000 Tavily credits/month and $2 of approved
# high-value OpenRouter automation calls per UTC month. Protected source previews
# are separately bounded per request and still consume the Tavily account quota.
AUTOMATION_BUDGET_USD_MONTHLY=2

# Optional: public web discovery through Tavily's free allocation.
# Thin Reddit results may receive at most two bounded Tavily basic-extraction
# reads per scan; Reddit URLs are normalized to old.reddit.com first.
TAVILY_API_KEY=

# Optional: use a dedicated OpenRouter key for this deployment. In OpenRouter,
# configure that key with a monthly limit of $2 or lower that resets monthly, then verify the
# provider-side setting manually before enabling automation; the repo cannot
# inspect or prove that dashboard setting.
OPENROUTER_API_KEY=
# High-value scanner extraction and official fix-claim mapping only. The default
# is first-party OpenAI through OpenRouter; DeepSeek V4 Flash is an explicit
# manual rollback value, never an automatic fallback.
OPENROUTER_AUTOMATION_MODEL=openai/gpt-5.6-luna
# Routine report moderation and dossier prose only; deterministic fallback remains.
OPENROUTER_FREE_MODEL=openrouter/free

# Optional: keyless Steam review aggregates and screened review intake. Keep off
# until the platform-pulse migration is applied and the rollout is approved.
# Uses the existing real-scan schedule, at most once every six hours.
STEAM_PULSE_ENABLED=false

# Optional: shared server-only Twitch application credentials for aggregate
# Twitch activity and public IGDB game metadata. Both values are required.
# Uses the existing real-scan schedule, at most once per hour.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: aggregate Steam-connected player counts. Keep off until the
# steam_player_snapshots migration is applied and the rollout is approved.
# Uses the existing scan schedule, at most once per hour; no API key required.
STEAM_PLAYER_COUNTS_ENABLED=false
