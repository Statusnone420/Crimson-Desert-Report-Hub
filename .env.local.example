# Copy this file to .env.local for local development.
# Never commit .env.local or real provider keys.

# Required: Supabase server-side database access.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required: admin login and signed session cookies.
ADMIN_PASSWORD=replace-with-long-private-passphrase
SESSION_SECRET=replace-with-64-hex-character-secret

# Required in production for cron/preview route authorization.
CRON_SECRET=replace-with-random-private-secret

# Strongly recommended: public report spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Automation cost control. Set to 0 to disable paid search/LLM work.
AUTOMATION_BUDGET_USD_MONTHLY=5
AUTOMATION_SUBREDDITS=CrimsonDesert

# Optional: public web search provider.
TAVILY_API_KEY=

# Optional: AI extraction/dossier drafting.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
GROQ_API_KEY=

# Optional: Reddit public-post monitor.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:crimson-desert-report-hub:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# Optional future paid provider. Leave empty for the zero-cost build.
XAI_API_KEY=
