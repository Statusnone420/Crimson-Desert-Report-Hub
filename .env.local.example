# Copy this file to .env.local for local development.
# Never commit .env.local or real provider keys.

# Required: Supabase server-side database access.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required: admin login and signed session cookies.
ADMIN_PASSWORD=replace-with-long-private-passphrase
SESSION_SECRET=replace-with-64-hex-character-secret

# Required in production for cron/preview route authorization.
CRON_SECRET=replace-with-random-private-secret

# Private scheduled-trigger evidence in the operator console. Use a dedicated
# Workers KV Storage Read token restricted to the scanner's Cloudflare account.
# Read only the existing ALERT_STATE namespace; no write or deploy permission.
# Preview deployments never read production execution records.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SCANNER_KV_NAMESPACE_ID=
CLOUDFLARE_SCANNER_STATUS_TOKEN=

# Strongly recommended: public report spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private Report a problem intake. Use a separate free Turnstile widget configured
# in Invisible mode; keep the existing check-in widget unchanged. The backend
# requires action=problem_report and the correct frontend hostname.
NEXT_PUBLIC_PROBLEM_REPORT_TURNSTILE_SITE_KEY=
PROBLEM_REPORT_TURNSTILE_SECRET_KEY=
# Required: independent random server-only salt, at least 32 characters.
# Keep it stable across application instances; do not reuse SESSION_SECRET.
PROBLEM_REPORT_IP_SALT=

# Legacy AI limits below apply until a primary is activated in AI settings.
# Activated profiles use the dashboard's shared monthly and per-request ledger.
# Tavily's ceiling remains unchanged. See docs/plans/ai-settings-dashboard.md.
# Real-scan software ceilings: 1000 Tavily credits/month and $1 of approved
# high-value OpenRouter automation calls per UTC month. The saved scanner budget
# defaults to $0.50 and is configurable from $0 to $1. Protected source previews
# return a query plan only; they do not contact Tavily or spend credits.
# This deployment ceiling also bounds the saved budget. Set 0 to disable paid AI;
# 1 permits the full private scanner-control range, including its $0.50 default.
AUTOMATION_BUDGET_USD_MONTHLY=1

# Optional: public web discovery through Tavily's free allocation.
# Thin Reddit results may receive at most two bounded Tavily basic-extraction
# reads per scan; Reddit URLs are normalized to old.reddit.com first.
TAVILY_API_KEY=

# Optional: use a dedicated OpenRouter key for this deployment. In OpenRouter,
# configure a monthly or lifetime limit of $1 or lower. The scanner inspects
# the key's limit, remaining credit, and monthly usage before inference.
# Daily, weekly, unlimited, or unverifiable limits block AI requests.
OPENROUTER_API_KEY=
# Optional after the AI settings migration: server-only encryption for keys saved
# through the operator dashboard. Canonical base64 of 32 random bytes. Keep its
# recovery copy in your password manager; never expose it through NEXT_PUBLIC_.
# See docs/plans/ai-settings-dashboard.md. Local/preview AI controls use sample data.
AI_SETTINGS_ENCRYPTION_KEY=
# High-value scanner extraction and official fix-claim mapping only. The default
# is first-party OpenAI through OpenRouter. The saved scanner preset selects
# Luna Standard, Luna Flex, or explicit DeepSeek V4 Flash rollback; it takes
# precedence over this environment value. There is no automatic model fallback.
OPENROUTER_AUTOMATION_MODEL=openai/gpt-5.6-luna
# Routine report moderation and dossier prose only; deterministic fallback remains.
OPENROUTER_FREE_MODEL=openrouter/free

# Optional: keyless Steam review aggregates and screened review intake. Keep off
# until the platform-pulse migration is applied and the rollout is approved.
# Uses the existing real-scan schedule, at most once every six hours.
STEAM_PULSE_ENABLED=false

# Optional: shared server-only Twitch application credentials for aggregate
# Twitch activity and public IGDB game metadata. Both values are required.
# Uses the existing real-scan schedule, at most once per hour.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: aggregate Steam-connected player counts. Keep off until the
# steam_player_snapshots migration is applied and the rollout is approved.
# Uses the existing scan schedule, at most once per hour; no API key required.
STEAM_PLAYER_COUNTS_ENABLED=false

# State of the Game column: names only, real values go in Vercel
ANTHROPIC_API_KEY=
COLUMN_OPENROUTER_API_KEY=
COLUMN_PREVIEW_TOKEN=
COLUMN_WRITER_MODEL=
COLUMN_WRITER_EFFORT=
COLUMN_CHECKER_MODEL=
COLUMN_BUDGET_USD_MONTHLY=
COLUMN_REQUEST_CAP_USD=
